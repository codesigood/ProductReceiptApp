{
  "name": "productreceiptapp",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop app for managing product receipts",
  "author": "Azmahpoint Nigeria Ltd <support@azmahpoint.com>",
  "license": "MIT",

  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.azmahpoint.productreceiptapp",
    "productName": "Product Receipt App",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "node_modules/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "scripts": {
    "dev:ui": "cross-env TAILWIND_DISABLE_WASM=true vite ",
    "dev:electron": "tsc-watch --project electron/tsconfig.json --onSuccess \"cross-env MAIN_WINDOW_VITE_DEV_SERVER_URL=http://localhost:5173 MAIN_WINDOW_VITE_NAME=main electron ./dist-electron/main.js\"",
    "dev": "concurrently -k \"npm run dev:ui\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "build:ui": "cross-env TAILWIND_DISABLE_WASM=true vite build",
    "build:electron": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json",
    "build": "npm run build:ui && npm run build:electron && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "electron ./dist-electron/main.js",
    "cap:sync": "npx cap sync",
    "rebuild:native": "electron-rebuild -f -w",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@google-cloud/local-auth": "^3.0.1",
    "@libsql/client": "^0.15.14",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/vite": "^4.1.12",
    "@types/nodemailer": "^7.0.1",
    "@types/recharts": "^1.8.29",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.2.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "electron-pos-printer": "1.3.6",
    "escpos": "^3.0.0-alpha.6",
    "escpos-usb": "^3.0.0-alpha.4",
    "framer-motion": "^12.23.12",
    "fs-extra": "^11.3.1",
    "google-auth-library": "^10.3.0",
    "googleapis": "^159.0.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "wait-on": "^8.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tsconfig/vite-react": "^7.0.0",
    "@types/escpos": "^2.5.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "lucide-react": "^0.542.0",
    "shadcn": "^3.1.0",
    "tsc-watch": "^7.1.1",
    "vite": "^7.1.2"
  },
  "externals": [
    "@emnapi/core",
    "@tailwindcss/oxide-wasm32-wasi"
  ]
}
